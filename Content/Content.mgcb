
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:..\pipeline-references\MonoGame.Extended.Content.Pipeline.dll

#---------------------------------- Content ---------------------------------#

#begin images/adventurer-texture.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:images/adventurer-texture.png

#begin images/adventurer.json
/importer:TexturePackerJsonImporter
/processor:TexturePackerProcessor
/build:images/adventurer.json

#begin images/enemy1-texture.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:images/enemy1-texture.png

#begin images/enemy1.json
/importer:TexturePackerJsonImporter
/processor:TexturePackerProcessor
/build:images/enemy1.json

#begin maps/Animated Tree1.tsx
/importer:TilemapTilesetImporter
/processor:TilemapTilesetProcessor
/build:maps/Animated Tree1.tsx

#begin maps/Animated water tiles-transp.tsx
/copy:maps/Animated water tiles-transp.tsx

#begin maps/Animated water tiles.tsx
/importer:TilemapTilesetImporter
/processor:TilemapTilesetProcessor
/build:maps/Animated water tiles.tsx

#begin maps/Atlas-Props.tsx
/importer:TilemapTilesetImporter
/processor:TilemapTilesetProcessor
/build:maps/Atlas-Props.tsx

#begin maps/Grass Land - tileset-cliff.tsx
/importer:TilemapTilesetImporter
/processor:TilemapTilesetProcessor
/build:maps/Grass Land - tileset-cliff.tsx

#begin maps/Grass Land - tileset-transp-cliff.tsx
/importer:TilemapTilesetImporter
/processor:TilemapTilesetProcessor
/build:maps/Grass Land - tileset-transp-cliff.tsx

#begin maps/props/props-atlas-texture.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:maps/props/props-atlas-texture.png;maps/props/props-atlas-texture

#begin maps/props/props-atlas.json
/importer:TexturePackerJsonImporter
/processor:TexturePackerProcessor
/build:maps/props/props-atlas.json;maps/props/props-atlas

#begin maps/Sample Map.tmx
/importer:TiledTilemapImporter
/processor:TilemapProcessor
/processorParam:LevelName=
/build:maps/Sample Map.tmx

#begin maps/sampleMapProps.xml
/copy:maps/sampleMapProps.xml

#begin maps/Terrain.tsx
/importer:TilemapTilesetImporter
/processor:TilemapTilesetProcessor
/build:maps/Terrain.tsx

